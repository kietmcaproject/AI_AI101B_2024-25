from google.colab import files
import torch
import math
from transformers import GPT2Tokenizer, GPT2LMHeadModel
# Step 1: Upload text file
uploaded = files.upload()
for filename in uploaded:
    with open(filename, 'r', encoding='utf-8') as f:
        input_text = f.read()

print("Preview of the uploaded text (first 500 chars):")
print(input_text[:500])
# Step 2: Load GPT-2 tokenizer and model
tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
model = GPT2LMHeadModel.from_pretrained("gpt2")
model.eval()
# Step 3: Perplexity calculation with sliding window
def calculate_perplexity_sliding_window(text, max_length=1024, stride=512):
    encodings = tokenizer(text, return_tensors='pt')
    input_ids = encodings.input_ids[0]
    nlls = []
    total_length = input_ids.size(0)
    for i in range(0, total_length, stride):
        begin_loc = i
        end_loc = min(i + max_length, total_length)
        trg_len = end_loc - begin_loc  # may be less than max_length
        input_ids_chunk = input_ids[begin_loc:end_loc]
        target_ids = input_ids_chunk.clone()
        with torch.no_grad():
            outputs = model(input_ids_chunk.unsqueeze(0), labels=target_ids.unsqueeze(0))
            neg_log_likelihood = outputs.loss * trg_len
        nlls.append(neg_log_likelihood)
        if end_loc == total_length:
            break
    ppl = torch.exp(torch.stack(nlls).sum() / total_length)
    return ppl.item()

perplexity_score = calculate_perplexity_sliding_window(input_text)
print(f"\nGPT-2 Perplexity score: {perplexity_score:.2f}")
# Step 4: Classification based on threshold
PERPLEXITY_THRESHOLD = 25

if perplexity_score < PERPLEXITY_THRESHOLD:
    print("\n===== FINAL VERDICT =====")
    print("The uploaded text is likely: *AI-generated*")
else:
    print("\n===== FINAL VERDICT =====")
    print("The uploaded text is likely: *Human-written*")
